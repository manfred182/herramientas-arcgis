<?xml version="1.0" encoding="utf-8"?>
<ArcGIS xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd"
        defaultAssembly="SalidasGraficasAddIn.dll"
        defaultNamespace="SalidasGraficasAddIn">
  <AddInInfo id="{5C6F85A9-C40C-4984-B75F-72B14E59D3F2}" version="1.3.0" desktopVersion="3.3.0">
    <Name>Salidas Gráficas Flotante</Name>
    <Description>Genera automáticamente planos de monitoreo por nombre de beneficiario.</Description>
    <Author>Amazon GIS</Author>
    <Company>Amazon GIS</Company>
    <Date>2026-08-18</Date>
    <Subject>Cartografía y monitoreo</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="AmazonGIS_SalidasGraficasV2_Module"
                  className="Module1"
                  autoLoad="false"
                  caption="Salidas Gráficas">
      <tabs>
        <tab id="AmazonGIS_SalidasGraficasV2_Tab" caption="SALIDAS GRÁFICAS" keytip="SG">
          <group refID="AmazonGIS_SalidasGraficasV2_Group" />
        </tab>
      </tabs>
      <groups>
        <group id="AmazonGIS_SalidasGraficasV2_Group"
               caption="Monitoreo"
               appearsOnAddInTab="true">
          <button refID="AmazonGIS_SalidasGraficasV2_OpenButton" size="large" />
        </group>
      </groups>
      <controls>
        <button id="AmazonGIS_SalidasGraficasV2_OpenButton"
                caption="Ventana flotante 1.3"
                className="OpenGeneratorButton"
                loadOnClick="true">
          <tooltip heading="Ventana flotante">Abre la ventana flotante que actualiza directamente el layout cargado.<disabledText /></tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>
